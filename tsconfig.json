{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "declaration": true,
    "sourceMap": true,
    "rootDir": ".",
    "outDir": "dist",
    "types": ["node", "vitest/globals"],
    "lib": ["ES2022"]
  },
  "include": ["infra/**/*.ts", "src/**/*.ts", "scripts/**/*.ts", "tests/**/*.ts"]
}
